{
	"name": "@spellkave/session",
	"version": "0.1.1",
	"private": true,
	"description": "Binding-keyed live Spellkave session core + daemon host (#1990) \u2014 one connect/subscribe-on-connect lifecycle shared by the daemon, the Pi extension, and future browser hosts.",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./node": {
			"types": "./src/node/index.ts",
			"default": "./src/node/index.ts"
		},
		"./node/observability": {
			"types": "./src/node/observability.ts",
			"default": "./src/node/observability.ts"
		},
		"./player-tools": {
			"types": "./src/player-tools/index.ts",
			"default": "./src/player-tools/index.ts"
		},
		"./authoring": {
			"types": "./src/authoring/index.ts",
			"default": "./src/authoring/index.ts"
		}
	},
	"files": [
		"bin",
		"src"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsc",
		"dev": "tsc --watch",
		"test": "vitest run",
		"test:live": "vitest run --config vitest.live.config.ts",
		"test:browser-gate": "node scripts/check-browser-resolution.mjs",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@spellkave/agent-observability": "workspace:*",
		"@spellkave/sdk": "workspace:*",
		"@spellkave/tool-contracts": "workspace:*",
		"@spellkave/tool-authoring": "workspace:*",
		"@spellkave/tool-node": "workspace:*",
		"@spellkave/tool-player": "workspace:*",
		"@spellkave/tool-runtime": "workspace:*",
		"@spellkave/world-author": "workspace:*",
		"@spellkave/world-map": "workspace:*",
		"@spellkave/bindings": "2.1.0"
	},
	"peerDependencies": {
		"typebox": "*"
	},
	"devDependencies": {
		"@spellkave/test-lab": "workspace:*",
		"@types/node": "^24.12.4",
		"esbuild": "0.28.1",
		"tsx": "^4.19.2",
		"typebox": "1.1.38",
		"vitest": "^3.2.6"
	},
	"license": "PolyForm-Shield-1.0.0"
}

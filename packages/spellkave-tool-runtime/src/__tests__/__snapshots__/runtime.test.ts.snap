exports[`tool runtime > coordinates a projected delta source and appends without rewriting primary content 1`] = `
{
  "content": [
    "primary",
    "{"world_deltas":{"affordance":{"added":["Bandage → Goblin"],"removed":[],"more":0}}}",
  ],
  "details": {
    "receipt": {
      "status": "success",
    },
    "world_deltas": {
      "affordance": {
        "added": [
          "Bandage → Goblin",
        ],
        "more": 0,
        "removed": [],
      },
    },
  },
}
`;


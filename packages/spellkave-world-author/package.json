{
	"name": "@spellkave/world-author",
	"version": "0.1.3",
	"private": true,
	"description": "Typed world-manifest authoring surface \u2014 builds manifest rows -> TOML for agent/code authors, plus optional pre-flight validation. Validation is NOT a client-side reimplementation: it calls the SAME Rust validator (crates/spellkave-validate) compiled to wasm, so that crate stays the single source of truth (ADR-0009 D-2 preserved). Tracker: #504.",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		"./npc-dm-documents": "./src/npc-dm-documents.ts",
		"./npc-dm-presentation": "./src/npc-dm-presentation.ts",
		"./npc-dm-srd": "./src/npc-dm-srd.ts",
		"./npc-quests": "./src/npc-quests.ts",
		"./npc-kinds": "./src/npc-kinds.ts",
		"./corpus": "./src/corpus.ts",
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./browser": {
			"types": "./src/browser.ts",
			"default": "./src/browser.ts"
		},
		"./tooling": {
			"types": "./src/tooling.ts",
			"browser": "./src/tooling.browser.ts",
			"default": "./src/tooling.ts"
		},
		"./tooling-browser": {
			"types": "./src/tooling.browser.ts",
			"default": "./src/tooling.browser.ts"
		},
		"./observation-tokens": {
			"types": "./src/observation-tokens.ts",
			"browser": "./src/observation-tokens.browser.ts",
			"default": "./src/observation-tokens.ts"
		},
		"./docs/*": "./docs/*"
	},
	"files": [
		"src",
		"docs"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsc",
		"dev": "tsc --watch",
		"test": "vitest run",
		"test:doc-evidence": "vitest run --includeTaskLocation --reporter=default --reporter=./src/test/doc-evidence/reporter.ts",
		"check:doc-evidence": "tsx src/test/doc-evidence/check.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@spellkave/tool-contracts": "workspace:*",
		"smol-toml": "^1.9.1",
		"@spellkave/validate-wasm": "0.1.0",
		"@spellkave/authoring-wasm": "0.1.0"
	},
	"devDependencies": {
		"@spellkave/sdk": "workspace:*",
		"@spellkave/test-lab": "workspace:*",
		"@types/node": "^24.12.4",
		"tsx": "^4.19.2",
		"vitest": "^3.2.6"
	},
	"license": "PolyForm-Shield-1.0.0"
}

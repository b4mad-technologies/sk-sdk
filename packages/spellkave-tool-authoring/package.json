{
	"name": "@spellkave/tool-authoring",
	"version": "0.1.1",
	"private": true,
	"description": "Browser-safe canonical execution bodies and orchestration for Spellkave AUTHOR tool contracts.",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./browser": {
			"types": "./src/browser.ts",
			"default": "./src/browser.ts"
		}
	},
	"files": [
		"src"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsc",
		"test": "vitest run",
		"test:browser-gate": "node scripts/check-browser-resolution.mjs",
		"test:forbidden-imports": "vitest run src/__tests__/forbidden-imports.test.ts"
	},
	"dependencies": {
		"@spellkave/tool-contracts": "workspace:*",
		"@spellkave/tool-runtime": "workspace:*",
		"@spellkave/world-author": "workspace:*",
		"@spellkave/world-map": "workspace:*",
		"h3-js": "^4.5.0",
		"typebox": "1.1.38"
	},
	"devDependencies": {
		"@types/node": "^24.12.4",
		"esbuild": "0.28.1",
		"vitest": "^3.2.6"
	},
	"license": "PolyForm-Shield-1.0.0"
}

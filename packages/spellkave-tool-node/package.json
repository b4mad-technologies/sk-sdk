{
	"name": "@spellkave/tool-node",
	"version": "0.1.1",
	"private": true,
	"description": "Node-only filesystem, local-credential, raster-output, and host-telemetry adapters for Spellkave tool runtime capability ports.",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./authoring": {
			"types": "./src/authoring/index.ts",
			"default": "./src/authoring/index.ts"
		}
	},
	"files": [
		"src"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsc",
		"test": "vitest run",
		"test:browser-gate": "node scripts/check-browser-resolution.mjs",
		"test:forbidden-imports": "vitest run src/__tests__/forbidden-imports.test.ts"
	},
	"dependencies": {
		"@spellkave/agent-observability": "workspace:*",
		"@spellkave/tool-contracts": "workspace:*",
		"@spellkave/tool-authoring": "workspace:*",
		"@spellkave/tool-runtime": "workspace:*",
		"@spellkave/world-map": "workspace:*",
		"@spellkave/world-author": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^24.12.4",
		"esbuild": "0.28.1",
		"vitest": "^3.2.6"
	},
	"license": "PolyForm-Shield-1.0.0"
}

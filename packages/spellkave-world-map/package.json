{
	"name": "@spellkave/world-map",
	"version": "0.1.1",
	"private": true,
	"description": "One geometry, three outputs: OSM export, MVT/MapLibre tiles, SVG/ASCII/braille spatial-graph. No HTTP \u2014 the gateway keeps routing/auth/CORS/assets.",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"bin": {
		"world-map": "./bin/world-map.js",
		"world-osm": "./bin/world-osm.js"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./tiles": {
			"types": "./src/tiles/index.ts",
			"default": "./src/tiles/index.ts"
		},
		"./svg": {
			"types": "./src/svg/index.ts",
			"default": "./src/svg/index.ts"
		},
		"./node": {
			"types": "./src/node/index.ts",
			"default": "./src/node/index.ts"
		},
		"./node/terminal": {
			"types": "./src/node/terminal.ts",
			"default": "./src/node/terminal.ts"
		},
		"./cli": {
			"types": "./src/cli.ts",
			"default": "./src/cli.ts"
		}
	},
	"files": [
		"bin",
		"src",
		"fixtures"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsc",
		"dev": "tsc --watch",
		"test": "vitest run",
		"test:behaviour": "vitest run --config vitest.behaviour.config.ts",
		"export": "tsx src/cli.ts export",
		"world-map": "tsx src/cli.ts",
		"world-osm": "tsx src/cli.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@maplibre/maplibre-gl-style-spec": "26.2.1",
		"@resvg/resvg-js": "^2.6.2",
		"@types/geojson-vt": "3.2.5",
		"geojson-vt": "4.0.2",
		"h3-js": "^4.5.0",
		"smol-toml": "^1.9.1",
		"termdot": "^0.1.13",
		"vt-pbf": "3.1.3",
		"@spellkave/sdk": "workspace:*"
	},
	"peerDependencies": {
		"@earendil-works/pi-tui": "1.5.2"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-tui": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-tui": "1.5.2",
		"@mapbox/vector-tile": "2.0.4",
		"@spellkave/behaviour": "workspace:*",
		"@types/node": "^24.12.4",
		"@types/pbf": "3.0.5",
		"allure-js-commons": "3.13.0",
		"allure-vitest": "3.13.0",
		"pbf": "4.0.1",
		"quickpickle": "1.11.2",
		"tsx": "^4.19.2",
		"typescript": "~5.9.3",
		"vitest": "^3.2.6"
	},
	"license": "PolyForm-Shield-1.0.0"
}
